{
  "name": "boost-rag-azure",
  "version": "0.1.0",
  "description": "RAG Azure Boost: agents, skills, prompts and instructions for RAG on Azure AI Search, self-installable for GitHub Copilot / VS Code.",
  "type": "module",
  "boostPrefix": "rag",
  "files": [
    ".github/agents",
    ".github/skills",
    ".github/prompts",
    ".github/instructions",
    "scripts/install.mjs",
    "README.md",
    "LICENSE"
  ],
  "scripts": {
    "boost:install": "node scripts/install.mjs",
    "boost:check": "node scripts/install.mjs --check",
    "release": "semantic-release",
    "release:dry": "semantic-release --dry-run"
  },
  "devDependencies": {
    "@semantic-release/changelog": "^6.0.3",
    "@semantic-release/commit-analyzer": "^11.1.0",
    "@semantic-release/github": "^10.3.5",
    "@semantic-release/npm": "^11.0.3",
    "@semantic-release/release-notes-generator": "^12.1.0",
    "conventional-changelog-conventionalcommits": "^8.0.0",
    "semantic-release": "^24.2.7"
  },
  "keywords": ["boost", "rag", "azure", "azure-ai-search", "agents", "skills", "copilot", "github-copilot", "agent-skills"],
  "author": "Sergio Hierro Cinos",
  "repository": { "type": "git", "url": "git+https://github.com/Sertxito/boost_RAG-Azure.git" },
  "bugs": { "url": "https://github.com/Sertxito/boost_RAG-Azure/issues" },
  "homepage": "https://github.com/Sertxito/boost_RAG-Azure#readme",
  "license": "MIT",
  "engines": { "node": ">=20" },
  "publishConfig": { "access": "public" },
  "bin": { "boost-rag-azure": "scripts/install.mjs" }
}
